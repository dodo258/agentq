#!/bin/sh
# 测试门：agentq 自己的完整检查（同 AGENTS.md「常用命令」）。引擎在一次性 worktree 的合并态上跑，约 8 分钟。
set -eu
cd "$(dirname "$0")/.."
unset GOROOT
# 只查仓库跟踪的文件：主检出下 .claude/worktrees/ 里的旧 worktree 不算
bad=$(git ls-files '*.go' | xargs gofmt -l)
test -z "$bad" || { echo "$bad"; echo "gofmt 没过"; exit 1; }
go vet ./...
GOOS=linux go vet ./...
go build ./...
GOOS=linux go build ./...
go test -race -count=1 -timeout 900s ./...
