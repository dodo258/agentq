#!/bin/sh
# 自动发版：.agentq/release [--check] <vX.Y.Z>。由 agentq 的自动发版调用（internal/release，见 docs/reference/features.md「自动发版」），也可以手动跑。
#   --check  只做说明书检查，不对外写：主页中英文写的命令、选项在 --help 里都有，版本号、支持矩阵对得上（tests/manual_test.go）。
#   不带     真发：同步公开仓 → 核对公开仓 main 就是这次导出的内容 → 打 tag 推上去 → 等 release 工作流 → 下载附件对校验值、临时 HOME 试装（scripts/try-release.sh）。
# 公开仓名由环境变量 AGENTQ_RELEASE_REPO 给（agentq 从 config.json 的 release_repos 取）。同步公开仓的命令只在本机私有配置里：
# ${AGENTQ_RELEASE_CONF:-~/.agentq/private/release.env} 写一行 RELEASE_SYNC=<脚本路径>（导出、隐私扫描、完整检查、推送 main，失败退出非 0）。
# CHANGELOG 的「未发布」由 agentq 在跑这一步之前记成这个版本。任何一步不过就退出非 0，不重试。
set -eu
cd "$(dirname "$0")/.."
unset GOROOT

check=0
if [ "${1:-}" = --check ]; then
	check=1
	shift
fi
if [ "$#" -ne 1 ]; then
	echo '用法：.agentq/release [--check] <vX.Y.Z>' >&2
	exit 2
fi
v=$1
if ! printf '%s\n' "$v" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
	echo "版本号要写成 vX.Y.Z：$v" >&2
	exit 2
fi
if [ "$check" = 1 ]; then
	exec go test -count=1 -run '^TestManual' ./tests
fi

repo=${AGENTQ_RELEASE_REPO:-}
[ -n "$repo" ] || {
	echo '没有 AGENTQ_RELEASE_REPO（config.json 的 release_repos 里登记 owner/repo）' >&2
	exit 2
}
conf=${AGENTQ_RELEASE_CONF:-$HOME/.agentq/private/release.env}
RELEASE_SYNC=
# shellcheck disable=SC1090 # 本机私有配置
[ ! -f "$conf" ] || . "$conf"
[ -n "$RELEASE_SYNC" ] || {
	echo "没配同步公开仓的命令：在 $conf 里写 RELEASE_SYNC=<脚本路径>" >&2
	exit 1
}
step() { echo "== $(date '+%F %T') $*"; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

step "同步公开仓（$RELEASE_SYNC）"
sh "$RELEASE_SYNC"

step "核对公开仓 main 就是这次导出的内容"
sh scripts/export-public.sh "$tmp/out" "$repo" >/dev/null
git clone -q --depth 1 "https://github.com/$repo.git" "$tmp/pub"
if ! diff -rq -x .git "$tmp/out" "$tmp/pub" >"$tmp/diff.txt"; then
	head -20 "$tmp/diff.txt"
	echo "公开仓 main 和这次导出的内容不一样（同步没推上去？），没打 tag" >&2
	exit 1
fi

step "打 tag $v"
if git -C "$tmp/pub" ls-remote --exit-code --tags origin "refs/tags/$v" >/dev/null 2>&1; then
	echo "公开仓已经有 $v" >&2
	exit 1
fi
git -C "$tmp/pub" tag "$v"
git -C "$tmp/pub" push -q origin "refs/tags/$v"

step "等 release 工作流"
deadline=$(($(date +%s) + 1800))
id=
while :; do
	id=$(gh run list --repo "$repo" --workflow release.yml --branch "$v" --limit 1 --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null || true)
	[ -z "$id" ] || break
	if [ "$(date +%s)" -ge "$deadline" ]; then
		echo "推了 tag 半小时还没看到 $v 的 release 工作流" >&2
		exit 1
	fi
	sleep 20
done
if ! gh run watch "$id" --repo "$repo" --exit-status --interval 30 >/dev/null; then
	echo "release 工作流没过：https://github.com/$repo/actions/runs/$id" >&2
	exit 1
fi

step "下载附件、对校验值、临时 HOME 试装"
gh release download "$v" --repo "$repo" --dir "$tmp/dl"
sh scripts/try-release.sh "$tmp/dl" "$v"
step "发了 https://github.com/$repo/releases/tag/$v"
