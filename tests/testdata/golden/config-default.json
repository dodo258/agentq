{
  "launchd_label": "io.agentq.agentq",
  "projects_root": "~/projects",
  "claude_path": "claude",
  "model": "opus",
  "effort": "high",
  "permission_mode": "bypassPermissions",
  "max_parallel": 2,
  "per_project": 2,
  "timeout": "4h",
  "retry_after": "12h",
  "limit_cooldown": "1h",
  "paused": false,
  "night_enabled": false,
  "review_enabled": false,
  "patrol_enabled": true,
  "notify_enabled": true,
  "usage_stop_session_pct": 70,
  "usage_stop_week_pct": 90,
  "discuss_enabled": true,
  "retention_days": 90
}
